---
import { business, text, todo, type Lang } from '../content';
import { telUrl, whatsappUrl } from '../lib/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang];
const a = business.address;
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <p class="footer__mark">
          <span>Arielove</span> <span class="italic">kolibe</span>
        </p>
        <p class="footer__former">{t.footer.former}</p>
      </div>

      <div class="footer__cols">
        <div>
          <h2 class="footer__h">{t.footer.contact}</h2>
          <address class="not-italic">
            {a.street}<br />
            {a.postalCode} {a.locality}, {a.country[lang]}
          </address>
          <ul class="footer__links">
            <li>
              <a href={telUrl}>
                <Icon name="phone" size={16} />
                {business.phoneDisplay}
              </a>
            </li>
            <li>
              <a href={whatsappUrl(lang)} target="_blank" rel="noopener">
                <Icon name="message-circle" size={16} />
                WhatsApp<span class="sr-only"> ({t.ui.newTab})</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="footer__h">{t.footer.book}</h2>
          <ul class="footer__links">
            <li>
              <a href={business.bookingUrl} target="_blank" rel="noopener">
                Booking.com
                <Icon name="arrow-up-right" size={15} />
                <span class="sr-only">({t.ui.newTab})</span>
              </a>
            </li>
            <li>
              <a href={business.airbnbUrl} target="_blank" rel="noopener">
                Airbnb
                <Icon name="arrow-up-right" size={15} />
                <span class="sr-only">({t.ui.newTab})</span>
              </a>
            </li>
            {
              todo.instagram && (
                <li>
                  <a href={todo.instagram} target="_blank" rel="noopener">
                    {t.footer.follow}
                    <Icon name="arrow-up-right" size={15} />
                    <span class="sr-only">({t.ui.newTab})</span>
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {business.name}. {t.footer.rights}</p>
      <a href="#top" class="footer__top-link">{t.ui.backToTop}</a>
      <!-- ss-credit v1 -->
      <a class="ss-credit" href={business.credit.url} target="_blank" rel="noopener">
        <svg class="ss-credit__mark" viewBox="1 0 100 120" aria-hidden="true" focusable="false"><path d="M80 12 22 36 51 60"></path><path class="ss-credit__accent" d="M51 60 80 84 22 108"></path></svg>
        <span>{t.footer.credit} <span class="ss-credit__name">{t.footer.creditName}</span></span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    content-visibility: auto;
    contain-intrinsic-size: auto 640px;
    background: var(--color-ink);
    color: rgb(250 246 239 / 0.9);
    padding-top: clamp(4rem, 8vw, 6rem);
    /* mesto za lepljivu traku na telefonu */
    padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
  }
  @media (min-width: 1024px) {
    .footer {
      padding-bottom: 0;
    }
  }
  .footer__top {
    display: grid;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }
  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .footer__mark {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    line-height: 1;
    color: var(--color-paper);
  }
  .footer__former {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: rgb(250 246 239 / 0.7);
  }
  .footer__cols {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 560px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .footer__h {
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-caramel-light);
  }
  .footer__links {
    margin-top: 0.5rem;
  }
  .footer__links a,
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    transition: color 0.25s;
  }
  .footer__links a:hover,
  .footer__top-link:hover {
    color: var(--color-caramel);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgb(250 246 239 / 0.14);
    font-size: 13px;
    color: rgb(250 246 239 / 0.75);
  }
  .footer__top-link {
    display: none;
  }
  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
    .footer__bottom > p {
      margin-right: auto;
    }
    .footer__top-link {
      display: inline-flex;
    }
  }
  .footer .ss-credit {
    min-height: 44px;
  }
</style>
