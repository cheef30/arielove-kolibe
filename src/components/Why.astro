---
import { text, type Lang } from '../content';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].why;
---

<section id="zasto" class="section why" aria-labelledby="why-title">
  <div class="wrap why__grid">
    <div class="why__head">
      <SectionHead num="03" label={t.label} title={t.title} id="why-title" titleClass="display-md max-w-[12ch]" />
    </div>

    <ul class="why__list">
      {
        t.items.map((item, i) => (
          <li class="why__item" data-reveal style={`--reveal-delay:${(i % 2) * 100}ms`}>
            <span class="why__icon">
              <Icon name={item.icon} size={24} strokeWidth={1.5} />
            </span>
            <h3 class="why__title">{item.title}</h3>
            <p class="why__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    background: var(--color-paper);
    border-block: 1px solid rgb(27 23 20 / 0.08);
  }
  .why__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .why__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 5rem;
    }
    .why__head {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
      align-self: start;
    }
  }

  .why__list {
    display: grid;
    border-top: 1px solid rgb(27 23 20 / 0.14);
  }
  @media (min-width: 700px) {
    .why__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .why__item:nth-child(odd) {
      padding-right: clamp(1.5rem, 3vw, 3rem);
      border-right: 1px solid rgb(27 23 20 / 0.14);
    }
    .why__item:nth-child(even) {
      padding-left: clamp(1.5rem, 3vw, 3rem);
    }
  }
  .why__item {
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid rgb(27 23 20 / 0.14);
  }
  .why__icon {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-caramel-deep);
    transition:
      background-color 0.4s var(--ease-out-soft),
      color 0.4s var(--ease-out-soft);
  }
  .why__item:hover .why__icon {
    background: var(--color-forest);
    color: var(--color-paper);
  }
  .why__title {
    margin-top: 1.25rem;
    font-size: clamp(1.65rem, 1.35rem + 0.9vw, 2.1rem);
    line-height: 1.1;
  }
  .why__text {
    margin-top: 0.75rem;
    max-width: 34ch;
    color: var(--color-ink-soft);
  }
</style>
