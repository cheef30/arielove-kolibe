---
import { images, text, todo, type Lang } from '../content';
import { quotes } from '../lib/site';
import Icon from './Icon.astro';
import Img from './Img.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].welcome;
const [open, close] = quotes[lang];
---

<section id="dobrodoslica" class="welcome section on-dark" aria-labelledby="welcome-title">
  <div class="wrap welcome__grid">
    <div class="welcome__media" data-reveal>
      <div class="frame welcome__main">
        <Img image={images.welcome} lang={lang} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 38vw, 88vw" />
      </div>
      <div class="frame welcome__small">
        <Img image={images.coffee} lang={lang} widths={[320, 480, 640]} sizes="(min-width: 1024px) 16vw, 40vw" />
      </div>
    </div>

    <div class="welcome__text">
      <div data-reveal>
        <p class="kicker">
          <span class="kicker__num">01</span>
          <span class="kicker__rule" aria-hidden="true"></span>
          <span>{t.title}</span>
        </p>
        <h2 id="welcome-title" class="welcome__quote">
          <span class="welcome__mark" aria-hidden="true">{open}</span>{t.quote}<span aria-hidden="true">{close}</span>
        </h2>
      </div>

      <div class="welcome__body" data-reveal style="--reveal-delay: 120ms">
        {t.body.map((p) => <p>{p}</p>)}
      </div>

      <ul class="welcome__facts" data-reveal style="--reveal-delay: 200ms">
        {t.facts.map((f) => (
          <li>
            <Icon name={f.icon} size={20} class="text-caramel-light" />
            <span>{f.text}</span>
          </li>
        ))}
        {todo.foundedYear && (
          <li>
            <Icon name="hand-heart" size={20} class="text-caramel-light" />
            <span>
              {t.since} {todo.foundedYear}.
            </span>
          </li>
        )}
      </ul>

      <p class="welcome__sign" data-reveal style="--reveal-delay: 260ms">{t.signature}</p>
    </div>
  </div>
</section>

<style>
  .welcome {
    position: relative;
    background: var(--color-forest);
    color: var(--color-paper);
    overflow: hidden;
  }
  /* blaga tekstura: tanke linije kao godovi drveta */
  .welcome::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 70% at 100% 0%, rgb(194 138 79 / 0.16), transparent 60%),
      repeating-radial-gradient(circle at 115% 120%, transparent 0 22px, rgb(250 246 239 / 0.035) 22px 23px);
  }

  .welcome__grid {
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }
  @media (min-width: 1024px) {
    .welcome__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
  }

  .welcome__media {
    position: relative;
    padding-right: 16%;
    padding-bottom: 12%;
  }
  .welcome__main {
    aspect-ratio: 4 / 5;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
  }
  .welcome__main::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(250 246 239 / 0.12);
  }
  .welcome__small {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
    border: 6px solid var(--color-forest);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }

  .welcome__quote {
    margin-top: 1.75rem;
    font-size: clamp(2.35rem, 1.5rem + 3.4vw, 4.6rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .welcome__mark {
    color: var(--color-caramel-light);
  }

  .welcome__body {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
    margin-top: 2rem;
    color: rgb(250 246 239 / 0.84);
  }

  .welcome__facts {
    display: grid;
    gap: 0.25rem;
    max-width: 36rem;
    margin-top: 2.25rem;
    border-top: 1px solid rgb(250 246 239 / 0.16);
  }
  .welcome__facts li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid rgb(250 246 239 / 0.16);
    font-weight: 600;
  }
  .welcome__facts :global(svg) {
    flex: none;
  }

  .welcome__sign {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-style: italic;
    color: var(--color-caramel);
  }
</style>
