---
import { getImage } from 'astro:assets';
import { images, text, type Lang } from '../content';
import { imageMeta } from '../lib/site';
import Icon from './Icon.astro';
import Img from './Img.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].gallery;

/* Velike verzije za lightbox (WebP), generišu se pri build-u. */
const large = await Promise.all(
  images.gallery.map(async (img) => {
    const meta = imageMeta(img.file);
    const width = Math.min(meta.width, meta.height > meta.width ? 1200 : 1800);
    const out = await getImage({ src: meta, width, format: 'webp', quality: 72 });
    return { src: out.src, width: out.attributes.width, height: out.attributes.height };
  }),
);
---

<section id="galerija" class="section gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="gallery__head">
      <SectionHead num="04" label={t.label} title={t.title} id="gallery-title" titleClass="display-lg max-w-[16ch]" />
      <p class="gallery__count" aria-hidden="true" data-reveal>
        <span>{images.gallery.length}</span>
      </p>
    </div>

    <ul class="mosaic" data-gallery>
      {
        images.gallery.map((img, i) => (
          <li class={`mosaic__item mosaic__item--${i + 1}`} data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <button
              type="button"
              class="mosaic__btn group"
              data-index={i}
              data-full={large[i].src}
              data-w={large[i].width}
              data-h={large[i].height}
              data-alt={img.alt[lang]}
              aria-label={`${t.open}: ${img.alt[lang]}`}
            >
              <span class="frame frame--zoom mosaic__frame">
                <Img image={img} lang={lang} widths={[360, 560, 800, 1100]} sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 100vw" />
              </span>
              <span class="mosaic__zoom" aria-hidden="true">
                <Icon name="maximize-2" size={18} />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="lightbox" aria-label={t.dialog} data-lightbox data-of={t.of}>
    <div class="lightbox__stage" data-lightbox-stage>
      <img class="lightbox__img" alt="" data-lightbox-img decoding="async" />
    </div>
    <div class="lightbox__bar">
      <p class="lightbox__caption">
        <span class="lightbox__counter" data-lightbox-counter></span>
        <span data-lightbox-caption></span>
      </p>
      <div class="lightbox__controls">
        <button type="button" class="lightbox__btn" data-lightbox-prev aria-label={t.prev}>
          <Icon name="chevron-left" size={22} />
        </button>
        <button type="button" class="lightbox__btn" data-lightbox-next aria-label={t.next}>
          <Icon name="chevron-right" size={22} />
        </button>
        <button type="button" class="lightbox__btn lightbox__btn--close" data-lightbox-close aria-label={t.close}>
          <Icon name="x" size={22} />
        </button>
      </div>
    </div>
  </dialog>
</section>

<style>
  .gallery__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .gallery__count {
    display: none;
    font-family: var(--font-serif);
    font-size: clamp(5rem, 3rem + 6vw, 9rem);
    font-weight: 500;
    font-style: italic;
    line-height: 0.8;
    color: rgb(138 85 39 / 0.22);
  }
  @media (min-width: 768px) {
    .gallery__count {
      display: block;
    }
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(8.5rem, 26vw, 13rem);
    grid-auto-flow: dense;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .mosaic__item {
    min-width: 0;
  }
  .mosaic__item--1,
  .mosaic__item--6 {
    grid-column: span 2;
    grid-row: span 2;
  }
  .mosaic__item--4,
  .mosaic__item--9 {
    grid-row: span 2;
  }

  @media (min-width: 1024px) {
    .mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: clamp(7rem, 9vw, 9.5rem);
      gap: 1rem;
    }
    .mosaic__item {
      grid-column: span 4;
      grid-row: span 2;
    }
    .mosaic__item--1 {
      grid-column: span 7;
      grid-row: span 4;
    }
    .mosaic__item--2,
    .mosaic__item--3 {
      grid-column: span 5;
      grid-row: span 2;
    }
    .mosaic__item--4 {
      grid-column: span 4;
      grid-row: span 3;
    }
    .mosaic__item--5 {
      grid-column: span 4;
      grid-row: span 3;
    }
    .mosaic__item--6 {
      grid-column: span 4;
      grid-row: span 3;
    }
    .mosaic__item--7 {
      grid-column: span 5;
      grid-row: span 3;
    }
    .mosaic__item--8 {
      grid-column: span 3;
      grid-row: span 3;
    }
    .mosaic__item--9 {
      grid-column: span 4;
      grid-row: span 3;
    }
    .mosaic__item--10 {
      grid-column: span 12;
      grid-row: span 3;
    }
  }

  .mosaic__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    cursor: zoom-in;
  }
  .mosaic__frame {
    display: block;
    height: 100%;
    border-radius: var(--radius-md);
  }
  .mosaic__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(12 20 15 / 0.35), transparent 45%);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-soft);
  }
  .mosaic__zoom {
    position: absolute;
    right: 0.875rem;
    bottom: 0.875rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: rgb(250 246 239 / 0.92);
    color: var(--color-ink);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease-out-soft),
      transform 0.4s var(--ease-out-soft);
  }
  .mosaic__btn:hover .mosaic__frame::after,
  .mosaic__btn:focus-visible .mosaic__frame::after {
    opacity: 1;
  }
  .mosaic__btn:hover .mosaic__zoom,
  .mosaic__btn:focus-visible .mosaic__zoom {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .mosaic__zoom {
      opacity: 0.92;
      transform: none;
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 14 11 / 0.96);
    color: var(--color-paper);
    overflow: hidden;
  }
  .lightbox[open] {
    display: flex;
    flex-direction: column;
    animation: lb-in 0.35s var(--ease-out-soft);
  }
  .lightbox::backdrop {
    background: rgb(10 14 11 / 0.9);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox__stage {
    position: relative;
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: max(1rem, env(safe-area-inset-top)) clamp(0.5rem, 3vw, 2.5rem) 0.5rem;
    touch-action: pan-y;
    user-select: none;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.75rem;
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease-out-soft);
  }
  .lightbox__img.is-loading {
    opacity: 0.35;
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem clamp(1rem, 3vw, 2.5rem) max(1rem, env(safe-area-inset-bottom));
  }
  .lightbox__caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    font-size: 0.9375rem;
    color: rgb(250 246 239 / 0.85);
  }
  .lightbox__counter {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-caramel);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .lightbox__controls {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }
  .lightbox__btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid rgb(250 246 239 / 0.3);
    color: var(--color-paper);
    transition: background-color 0.25s;
  }
  .lightbox__btn:hover {
    background: rgb(250 246 239 / 0.12);
  }
  .lightbox__btn--close {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-paper);
  }
  .lightbox__btn--close:hover {
    background: #fff;
  }
  .lightbox :focus-visible {
    outline-color: var(--color-caramel);
  }
</style>
