---
import { business, reviews, text, type Lang } from '../content';
import { formatNumber } from '../lib/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].reviews;
const g = business.ratings.google;
---

<section id="utisci" class="section reviews" aria-labelledby="reviews-title">
  <div class="wrap reviews__grid">
    <div class="reviews__aside">
      <SectionHead num="05" label={t.label} title={t.title} id="reviews-title" titleClass="display-md" />
      <div class="score" data-reveal style="--reveal-delay: 120ms">
        <p class="score__value">{formatNumber(g.value, lang)}</p>
        <div>
          <p class="stars" role="img" aria-label={t.stars}>
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} fill="currentColor" strokeWidth={0} />)}
          </p>
          <p class="score__text">{t.summary}</p>
        </div>
      </div>
      {t.note && <p class="reviews__note" data-reveal>{t.note}</p>}
    </div>

    <div class="reviews__main">
      <ul class="cards" data-carousel tabindex="0" aria-label={t.carousel}>
        {
          reviews.map((r, i) => (
            <li class:list={['card', { 'card--feature': i === 0 }]} data-reveal style={`--reveal-delay:${(i % 2) * 100}ms`}>
              <figure class="card__inner">
                <p class="stars stars--sm" role="img" aria-label={t.stars}>
                  {Array.from({ length: r.rating }).map(() => (
                    <Icon name="star" size={15} fill="currentColor" strokeWidth={0} />
                  ))}
                </p>
                <blockquote class="card__quote" lang={r.lang}>
                  <p>{r.text}</p>
                </blockquote>
                <figcaption class="card__by">
                  <span class="card__author">{r.author}</span>
                  <span class="card__source">
                    {t.on} {r.source}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="carousel-nav" data-carousel-nav>
        <button type="button" class="carousel-btn" data-carousel-prev aria-label={t.prev}>
          <Icon name="chevron-left" size={22} />
        </button>
        <p class="carousel-count" aria-hidden="true"><span data-carousel-current>1</span> / {reviews.length}</p>
        <button type="button" class="carousel-btn" data-carousel-next aria-label={t.next}>
          <Icon name="chevron-right" size={22} />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--color-sand);
    overflow: hidden;
  }
  .reviews__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .reviews__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4.5rem;
    }
  }

  .score {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(27 23 20 / 0.16);
  }
  .score__value {
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 3.5rem + 3vw, 6.5rem);
    font-weight: 500;
    line-height: 0.85;
    color: var(--color-forest);
    font-variant-numeric: lining-nums;
  }
  .score__text {
    margin-top: 0.5rem;
    max-width: 22ch;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
  }
  .reviews__note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }

  .stars {
    display: flex;
    gap: 0.15rem;
    color: var(--color-caramel-deep);
  }

  /* Telefon: karusel koji se prevlači */
  .cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: 0.875rem;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .cards::-webkit-scrollbar {
    display: none;
  }
  .cards:focus-visible {
    outline-offset: -2px;
  }
  .card {
    scroll-snap-align: start;
    min-width: 0;
  }
  .card__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    box-shadow: var(--shadow-soft);
    transition:
      transform 0.5s var(--ease-out-soft),
      box-shadow 0.5s var(--ease-out-soft);
  }
  .card__quote {
    flex: 1;
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.65rem);
    font-weight: 500;
    line-height: 1.3;
  }
  .card__by {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(27 23 20 / 0.12);
    font-size: 0.9375rem;
  }
  .card__author {
    font-weight: 600;
  }
  .card__source {
    color: var(--color-ink-soft);
  }

  .carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .carousel-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid rgb(27 23 20 / 0.2);
    background: var(--color-paper);
    transition:
      background-color 0.25s,
      opacity 0.25s;
  }
  .carousel-btn:hover {
    background: #fff;
  }
  .carousel-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .carousel-count {
    min-width: 3.5rem;
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* Tablet i računar: asimetrična mreža */
  @media (min-width: 768px) {
    .cards {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 1.25rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
    .card--feature {
      grid-column: 1 / -1;
    }
    .card--feature .card__quote {
      font-size: clamp(1.8rem, 1.3rem + 1.4vw, 2.5rem);
      line-height: 1.18;
    }
    .card:nth-child(even) {
      transform: translateY(1.5rem);
    }
    .card:nth-child(even).is-in {
      transform: translateY(1.5rem);
    }
    .card__inner:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
    .carousel-nav {
      display: none;
    }
    .reviews__main {
      padding-bottom: 1.5rem;
    }
  }
</style>
