---
import { text, type Lang } from '../content';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].info;
---

<section id="informacije" class="section info" aria-labelledby="info-title">
  <div class="wrap">
    <SectionHead num="07" label={t.label} title={t.title} id="info-title" titleClass="display-md" />
    <dl class="info__grid">
      {
        t.items.map((item, i) => (
          <div class="info__item" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <dt>
              <Icon name={item.icon} size={22} strokeWidth={1.5} />
              <span>{item.title}</span>
            </dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .info {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .info__grid {
    display: grid;
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid rgb(27 23 20 / 0.14);
  }
  @media (min-width: 640px) {
    .info__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .info__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 3.5rem;
    }
  }
  .info__item {
    padding-block: 1.5rem 1.75rem;
    border-bottom: 1px solid rgb(27 23 20 / 0.14);
  }
  .info__item dt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .info__item dt :global(svg) {
    flex: none;
    color: var(--color-caramel-deep);
  }
  .info__item dd {
    margin-top: 0.5rem;
    padding-left: 2.125rem;
    color: var(--color-ink-soft);
  }
</style>
