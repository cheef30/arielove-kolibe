---
import { business, text, type Lang } from '../content';
import { telUrl } from '../lib/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].location;
const a = business.address;
const embed = `${business.mapsEmbedUrl}&hl=${lang}`;
---

<section id="lokacija" class="section location" aria-labelledby="location-title">
  <div class="wrap location__grid">
    <div>
      <SectionHead num="08" label={t.label} title={t.title} id="location-title" titleClass="display-md max-w-[12ch]" />
      <p class="lead mt-6 max-w-[34rem] text-ink-soft" data-reveal>{t.text}</p>

      <dl class="loc-data" data-reveal>
        <div>
          <dt>{t.address}</dt>
          <dd>
            <address class="not-italic">
              {a.street}<br />
              {a.postalCode} {a.locality}, {a.country[lang]}
            </address>
          </dd>
        </div>
        <div>
          <dt>{t.phone}</dt>
          <dd>
            <a href={telUrl} class="text-link font-semibold">{business.phoneDisplay}</a>
          </dd>
        </div>
        <div>
          <dt>{t.coords}</dt>
          <dd class="tabular-nums">
            {business.geo.lat}, {business.geo.lng}
          </dd>
        </div>
      </dl>

      <a href={business.mapsUrl} target="_blank" rel="noopener" class="btn btn--forest mt-8" data-reveal>
        <Icon name="map-pin" size={18} />
        {t.openMaps}
        <span class="sr-only">({text[lang].ui.newTab})</span>
      </a>
    </div>

    <div class="map frame" data-map data-src={embed} data-title={t.mapTitle} data-reveal>
      <svg class="map__art" viewBox="0 0 600 480" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M-20 120 C 80 60, 170 140, 260 90 S 430 20, 620 80" opacity=".35" />
          <path d="M-20 160 C 90 100, 180 180, 270 130 S 440 70, 620 125" opacity=".3" />
          <path d="M-20 205 C 100 150, 190 220, 280 175 S 450 120, 620 170" opacity=".26" />
          <path d="M-20 390 C 90 340, 200 420, 300 370 S 460 300, 620 350" opacity=".3" />
          <path d="M-20 430 C 100 380, 210 460, 310 410 S 470 340, 620 395" opacity=".26" />
          <path d="M60 300 C 60 250, 140 240, 170 270 S 190 340, 130 345 S 60 340, 60 300 Z" opacity=".35" />
          <path d="M40 300 C 40 230, 160 220, 195 265 S 210 365, 125 368 S 40 360, 40 300 Z" opacity=".25" />
          <path d="M430 270 C 430 225, 510 215, 540 250 S 545 320, 490 325 S 430 315, 430 270 Z" opacity=".35" />
          <path d="M405 270 C 405 205, 525 195, 565 245 S 570 345, 485 350 S 405 335, 405 270 Z" opacity=".25" />
        </g>
        <path d="M-20 262 C 120 250, 220 300, 300 268 S 470 220, 620 236" fill="none" stroke="currentColor" stroke-width="5" opacity=".5" stroke-linecap="round" />
        <path d="M150 470 C 170 380, 260 360, 250 300 S 330 230, 300 160 S 360 60, 440 -10" fill="none" stroke="#c28a4f" stroke-width="2" stroke-dasharray="7 7" opacity=".9" />
      </svg>

      <div class="map__pin" aria-hidden="true">
        <span class="map__pulse"></span>
        <Icon name="map-pin" size={30} strokeWidth={1.8} />
      </div>

      <div class="map__card">
        <p class="map__name">{business.name}</p>
        <p class="map__sub">{a.locality}, {a.country[lang]}</p>
        <button type="button" class="btn btn--cream map__btn" data-map-load>
          {t.showMap}
        </button>
        <p class="map__note">{t.mapNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .location__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .location__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
      align-items: center;
    }
  }

  .loc-data {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(27 23 20 / 0.14);
  }
  @media (min-width: 560px) {
    .loc-data {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .loc-data dt {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-caramel-deep);
  }
  .loc-data dd {
    margin-top: 0.25rem;
  }
  .loc-data a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: -0.6rem;
  }

  .map {
    position: relative;
    aspect-ratio: 5 / 4;
    min-height: 22rem;
    background: var(--color-forest);
    color: var(--color-paper);
  }
  @media (max-width: 559px) {
    .map {
      aspect-ratio: auto;
      min-height: 30rem;
    }
  }
  .map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map__pin {
    position: absolute;
    left: 50%;
    top: 44%;
    display: grid;
    place-items: center;
    color: var(--color-caramel);
    transform: translate(-50%, -100%);
  }
  .map__pin :global(svg) {
    position: relative;
    fill: var(--color-forest-deep);
  }
  .map__pulse {
    position: absolute;
    left: 50%;
    bottom: -0.35rem;
    width: 1.25rem;
    height: 1.25rem;
    margin-left: -0.625rem;
    border-radius: 999px;
    background: rgb(194 138 79 / 0.45);
    animation: pulse 2.6s var(--ease-out-soft) infinite;
  }
  @keyframes pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .map__card {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    padding: 1.25rem 1.25rem 1rem;
    border-radius: var(--radius-md);
    background: rgb(19 34 25 / 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgb(250 246 239 / 0.14);
  }
  @media (min-width: 560px) {
    .map__card {
      left: 1.5rem;
      right: auto;
      bottom: 1.5rem;
      max-width: 22rem;
    }
  }
  .map__name {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.1;
  }
  .map__sub {
    font-size: 0.9375rem;
    color: rgb(250 246 239 / 0.8);
  }
  .map__btn {
    margin-top: 1rem;
    min-height: 2.875rem;
  }
  .map__note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(250 246 239 / 0.78);
  }

  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
