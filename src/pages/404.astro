---
import Base from '../layouts/Base.astro';
import { pathFor } from '../lib/site';
---

<Base lang="sr">
  <main class="grid min-h-svh place-items-center bg-forest px-6 text-center text-paper">
    <div>
      <p class="font-serif text-[clamp(6rem,20vw,12rem)] leading-none italic text-caramel">404</p>
      <h1 class="mt-4 text-[clamp(2rem,6vw,3.5rem)]">Ova stranica ne postoji.</h1>
      <p class="mt-3 text-paper/80">This page does not exist. Такой страницы нет.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={pathFor('sr')} class="btn btn--cream">Arielove kolibe</a>
        <a href={pathFor('en')} class="btn btn--glass">English</a>
        <a href={pathFor('ru')} class="btn btn--glass">Русский</a>
      </div>
    </div>
  </main>
</Base>
